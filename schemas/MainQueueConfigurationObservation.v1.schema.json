{
  "additionalProperties": false,
  "description": "The authoritative, empty queue configuration read before enqueue.",
  "properties": {
    "bypass_allowed": {
      "const": false,
      "default": false,
      "title": "Bypass Allowed",
      "type": "boolean"
    },
    "direct_merge_allowed": {
      "const": false,
      "default": false,
      "title": "Direct Merge Allowed",
      "type": "boolean"
    },
    "expected_base_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Expected Base Commit",
      "type": "string"
    },
    "expected_base_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Expected Base Tree",
      "type": "string"
    },
    "isolated_release_issuer": {
      "minLength": 1,
      "title": "Isolated Release Issuer",
      "type": "string"
    },
    "issuer_isolation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Issuer Isolation Digest",
      "type": "string"
    },
    "max_entries_per_group": {
      "const": 1,
      "default": 1,
      "title": "Max Entries Per Group",
      "type": "integer"
    },
    "merge_method": {
      "const": "squash",
      "title": "Merge Method",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "protection_epoch": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protection Epoch",
      "type": "string"
    },
    "protection_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protection Manifest Digest",
      "type": "string"
    },
    "provider_api_version": {
      "minLength": 1,
      "title": "Provider Api Version",
      "type": "string"
    },
    "provider_identity": {
      "minLength": 1,
      "title": "Provider Identity",
      "type": "string"
    },
    "queue_configuration_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Queue Configuration Digest",
      "type": "string"
    },
    "queue_enabled": {
      "const": true,
      "default": true,
      "title": "Queue Enabled",
      "type": "boolean"
    },
    "release_issuer_app_id": {
      "exclusiveMinimum": 0,
      "title": "Release Issuer App Id",
      "type": "integer"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    }
  },
  "required": [
    "repository_digest",
    "operation_id",
    "queue_configuration_digest",
    "expected_base_commit",
    "expected_base_tree",
    "protection_manifest_digest",
    "protection_epoch",
    "provider_identity",
    "provider_api_version",
    "merge_method",
    "isolated_release_issuer",
    "release_issuer_app_id",
    "issuer_isolation_digest",
    "observed_at"
  ],
  "title": "MainQueueConfigurationObservation",
  "type": "object"
}
