        "authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Authority Digest",
          "type": "string"
        },
        "authorized_at": {
          "format": "date-time",
          "title": "Authorized At",
          "type": "string"
        },
        "controller_config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Controller Config Digest",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "issuer_authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Issuer Authority Digest",
          "type": "string"
        },
        "issuer_identity": {
          "minLength": 1,
          "title": "Issuer Identity",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "policy_epoch": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Epoch",
          "type": "string"
        },
        "protocol_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Protocol Digest",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_ref": {
          "const": "refs/heads/main",
          "default": "refs/heads/main",
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "repository_digest",
        "protocol_digest",
        "controller_config_digest",
        "policy_digest",
        "policy_epoch",
        "issuer_identity",
        "issuer_authority_digest",
        "authorized_at",
        "expires_at",
        "authority_digest"
      ],
      "title": "MainLedgerControllerAuthority",
      "type": "object"
    },
    "MainLedgerHostedRollbackProof": {
      "additionalProperties": false,
      "description": "Fresh hosted main rollback proof required before ledger activation.",
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "completion_state": {
          "const": "successful",
          "default": "successful",
          "title": "Completion State",
          "type": "string"
