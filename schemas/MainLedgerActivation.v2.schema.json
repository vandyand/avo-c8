        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "result_evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Evidence Digest",
          "type": "string"
        },
        "rollback_authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rollback Authority Digest",
          "type": "string"
        },
        "rollback_authority_identity": {
          "minLength": 1,
          "title": "Rollback Authority Identity",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_ref": {
          "const": "refs/heads/main",
          "default": "refs/heads/main",
          "title": "Target Ref",
          "type": "string"
        }
