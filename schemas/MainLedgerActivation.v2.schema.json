      "type": "string"
    },
    "scheduler_sequence_watermark": {
      "minimum": 0,
      "title": "Scheduler Sequence Watermark",
      "type": "integer"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    },
    "threshold": {
      "const": 12,
      "default": 12,
      "title": "Threshold",
      "type": "integer"
