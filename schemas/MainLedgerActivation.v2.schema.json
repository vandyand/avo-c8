    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "policy_epoch": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Epoch",
      "type": "string"
    },
    "protocol_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protocol Digest",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "rollback_authority_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rollback Authority Digest",
      "type": "string"
    },
    "rollback_authority_identity": {
      "minLength": 1,
