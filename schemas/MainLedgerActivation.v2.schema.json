      "required": [
        "operation_id",
        "repository_digest",
        "proof_artifact_digest",
        "controller_authority_digest",
        "rollback_authority_identity",
        "rollback_authority_digest",
        "result_evidence_digest",
        "completed_at",
        "proof_digest"
      ],
      "title": "MainLedgerHostedRollbackProof",
      "type": "object"
    }
