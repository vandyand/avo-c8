          "type": "boolean"
        },
        "fresh_hosted": {
          "const": true,
          "default": true,
          "title": "Fresh Hosted",
          "type": "boolean"
        },
        "operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
