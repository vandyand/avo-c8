{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "role",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "MainGraduationOfflineEvidenceKind": {
      "description": "Controller-defined native evidence namespaces (never substring matched).",
      "enum": [
        "c4-completion",
        "c4-recovery",
        "c5-rollback",
        "c5-cleanup",
        "c6-ledger",
        "c6-boundary",
        "c6-threshold",
        "provider-attester",
        "controller-verifier",
        "execution-authority",
        "execution-report",
        "junit-xml"
      ],
      "title": "MainGraduationOfflineEvidenceKind",
      "type": "string"
    },
    "MainGraduationOfflineEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "kind": {
          "$ref": "#/$defs/MainGraduationOfflineEvidenceKind"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "artifact"
      ],
      "title": "MainGraduationOfflineEvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "deploy_performed": {
      "const": false,
      "default": false,
      "title": "Deploy Performed",
      "type": "boolean"
    },
    "execution_authority_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Authority Digest",
      "type": "string"
    },
    "execution_report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Report Digest",
      "type": "string"
    },
    "fault_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Fault Digest",
      "type": "string"
    },
    "junit_xml_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Junit Xml Digest",
      "type": "string"
    },
    "native_evidence_refs": {
      "items": {
        "$ref": "#/$defs/MainGraduationOfflineEvidenceRef"
      },
      "maxItems": 16,
      "minItems": 2,
      "title": "Native Evidence Refs",
      "type": "array"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "oracle_expected_outcome": {
      "enum": [
        "passed",
        "pass",
        "success",
        "rejected",
        "safe_rejection",
        "reconciliation_required",
        "reconcile",
        "failed",
        "replayed"
      ],
      "title": "Oracle Expected Outcome",
      "type": "string"
    },
    "oracle_expected_state": {
      "enum": [
        "unchanged",
        "failed_closed",
        "reconciled",
        "completed",
        "replayed_read_only",
        "rejected",
        "reconciliation_required",
        "read_only"
      ],
      "title": "Oracle Expected State",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "reason_code": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Reason Code",
      "type": "string"
    },
    "result_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Result Digest",
      "type": "string"
    },
    "root_operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Root Operation Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "vector_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,95}$",
      "title": "Vector Id",
      "type": "string"
    },
    "verification_status": {
      "const": "pass",
      "default": "pass",
      "title": "Verification Status",
      "type": "string"
    }
  },
  "required": [
    "root_operation_id",
    "plan_digest",
    "case_id",
    "vector_id",
    "operation_id",
    "oracle_expected_outcome",
    "oracle_expected_state",
    "fault_digest",
    "reason_code",
    "execution_authority_digest",
    "execution_report_digest",
    "junit_xml_digest",
    "native_evidence_refs",
    "result_digest"
  ],
  "title": "MainGraduationOfflineDrillCaseResult",
  "type": "object"
}
