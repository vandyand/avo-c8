{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "role",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "MainGraduationOfflineEvidenceKind": {
      "description": "Controller-defined native evidence namespaces (never substring matched).",
      "enum": [
        "c4-completion",
        "c4-recovery",
        "c5-rollback",
        "c5-cleanup",
        "c6-ledger",
        "c6-boundary",
        "c6-threshold",
        "provider-attester",
        "controller-verifier",
        "execution-authority",
        "execution-report",
        "junit-xml"
      ],
      "title": "MainGraduationOfflineEvidenceKind",
      "type": "string"
    },
    "MainGraduationOfflineEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "kind": {
          "$ref": "#/$defs/MainGraduationOfflineEvidenceKind"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "artifact"
      ],
      "title": "MainGraduationOfflineEvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "collected": {
      "const": true,
      "default": true,
      "title": "Collected",
      "type": "boolean"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/MainGraduationOfflineEvidenceRef"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "exit_status": {
      "const": 0,
      "default": 0,
      "title": "Exit Status",
      "type": "integer"
    },
    "node_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Node Id",
      "type": "string"
    },
    "parameter_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Parameter Id",
      "type": "string"
    },
    "reason_code": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Reason Code",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "vector_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,95}$",
      "title": "Vector Id",
      "type": "string"
    },
    "verification_status": {
      "const": "pass",
      "default": "pass",
      "title": "Verification Status",
      "type": "string"
    }
  },
  "required": [
    "node_id",
    "parameter_id",
    "case_id",
    "vector_id",
    "reason_code",
    "evidence_refs"
  ],
  "title": "MainGraduationOfflineNodeObservation",
  "type": "object"
}
