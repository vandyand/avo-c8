{
  "$defs": {
    "MainGraduationOfflineDrillCaseSpec": {
      "additionalProperties": false,
      "properties": {
        "case_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Case Digest",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "plan_operation_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Operation Id"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "vectors": {
          "items": {
            "$ref": "#/$defs/MainGraduationOfflineDrillVectorSpec"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Vectors",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "vectors",
        "case_digest"
      ],
      "title": "MainGraduationOfflineDrillCaseSpec",
      "type": "object"
    },
    "MainGraduationOfflineDrillVectorSpec": {
      "additionalProperties": false,
      "description": "One immutable expected vector in the C7 matrix.",
      "properties": {
        "expected_outcome": {
          "enum": [
            "passed",
            "pass",
            "success",
            "rejected",
            "safe_rejection",
            "reconciliation_required",
            "reconcile",
            "failed",
            "replayed"
          ],
          "title": "Expected Outcome",
          "type": "string"
        },
        "expected_state": {
          "enum": [
            "unchanged",
            "failed_closed",
            "reconciled",
            "completed",
            "replayed_read_only",
            "rejected",
            "reconciliation_required",
            "read_only"
          ],
          "title": "Expected State",
          "type": "string"
        },
        "fault_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Fault Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "vector_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Vector Digest",
          "type": "string"
        },
        "vector_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,95}$",
          "title": "Vector Id",
          "type": "string"
        }
      },
      "required": [
        "vector_id",
        "expected_outcome",
        "expected_state",
        "fault_digest",
        "vector_digest"
      ],
      "title": "MainGraduationOfflineDrillVectorSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Activation Digest",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/MainGraduationOfflineDrillCaseSpec"
      },
      "maxItems": 15,
      "minItems": 15,
      "title": "Cases",
      "type": "array"
    },
    "configuration_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Configuration Digest",
      "type": "string"
    },
    "controller_authority_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Controller Authority Digest",
      "type": "string"
    },
    "controller_authority_ref": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Controller Authority Ref",
      "type": "string"
    },
    "deploy_performed": {
      "const": false,
      "default": false,
      "title": "Deploy Performed",
      "type": "boolean"
    },
    "execution_authority_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Authority Digest"
    },
    "execution_authority_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Authority Ref"
    },
    "main_before_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Main Before Commit",
      "type": "string"
    },
    "main_before_parents": {
      "items": {
        "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 0,
      "title": "Main Before Parents",
      "type": "array"
    },
    "main_before_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Main Before Tree",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "policy_epoch_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Epoch Digest",
      "type": "string"
    },
    "proof_class": {
      "const": "deterministic-offline-proof",
      "default": "deterministic-offline-proof",
      "title": "Proof Class",
      "type": "string"
    },
    "protocol_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protocol Digest",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "repository_digest",
    "protocol_digest",
    "configuration_digest",
    "policy_digest",
    "policy_epoch_digest",
    "activation_digest",
    "controller_authority_digest",
    "controller_authority_ref",
    "main_before_commit",
    "main_before_tree",
    "main_before_parents",
    "cases",
    "plan_digest"
  ],
  "title": "MainGraduationOfflineDrillPlan",
  "type": "object"
}
