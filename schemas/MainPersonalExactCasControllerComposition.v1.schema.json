{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "role",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable evidence root; it is not an authority or readiness grant.\n\nThe root intentionally records a forward operation only.  Rollback has a\nseparate operation and must not reuse this identity or its source.",
  "properties": {
    "activation_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "activation_authority_sufficient": {
      "const": false,
      "default": false,
      "title": "Activation Authority Sufficient",
      "type": "boolean"
    },
    "activation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Activation Digest",
      "type": "string"
    },
    "base_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Base Commit",
      "type": "string"
    },
    "base_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Base Tree",
      "type": "string"
    },
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "candidate_parents": {
      "items": {
        "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
        "type": "string"
      },
      "title": "Candidate Parents",
      "type": "array"
    },
    "candidate_ref": {
      "pattern": "^refs/heads/avo/candidate/[0-9a-f]{64}$",
      "title": "Candidate Ref",
      "type": "string"
    },
    "candidate_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Candidate Tree",
      "type": "string"
    },
    "claim_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Claim Digest",
      "type": "string"
    },
    "claim_nonce": {
      "minLength": 1,
      "title": "Claim Nonce",
      "type": "string"
    },
    "completion_claimed": {
      "const": false,
      "default": false,
      "title": "Completion Claimed",
      "type": "boolean"
    },
    "deploy_performed": {
      "const": false,
      "default": false,
      "title": "Deploy Performed",
      "type": "boolean"
    },
    "fresh_activation_required": {
      "const": true,
      "default": true,
      "title": "Fresh Activation Required",
      "type": "boolean"
    },
    "hosted_identity_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Hosted Identity Bundle Digest",
      "type": "string"
    },
    "hosted_identity_root_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "is_authoritative": {
      "const": false,
      "default": false,
      "title": "Is Authoritative",
      "type": "boolean"
    },
    "is_terminal": {
      "const": false,
      "default": false,
      "title": "Is Terminal",
      "type": "boolean"
    },
    "lease_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "lease_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Lease Digest",
      "type": "string"
    },
    "lease_expires_at": {
      "format": "date-time",
      "title": "Lease Expires At",
      "type": "string"
    },
    "lease_identity": {
      "minLength": 1,
      "title": "Lease Identity",
      "type": "string"
    },
    "mutation_performed": {
      "const": false,
      "default": false,
      "title": "Mutation Performed",
      "type": "boolean"
    },
    "observer_configuration_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Observer Configuration Digest",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "operation_kind": {
      "const": "forward",
      "default": "forward",
      "title": "Operation Kind",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "protection_ruleset_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protection Ruleset Digest",
      "type": "string"
    },
    "protocol_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protocol Digest",
      "type": "string"
    },
    "readiness_authorized": {
      "const": false,
      "default": false,
      "title": "Readiness Authorized",
      "type": "boolean"
    },
    "receipt_issued": {
      "const": false,
      "default": false,
      "title": "Receipt Issued",
      "type": "boolean"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "root_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Root Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_composition_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_composition_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Composition Digest",
      "type": "string"
    },
    "source_composition_proof_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Operation Id",
      "type": "string"
    },
    "source_package_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_package_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Package Digest",
      "type": "string"
    },
    "source_plan_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Plan Digest",
      "type": "string"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    },
    "writer_app_id": {
      "title": "Writer App Id",
      "type": "integer"
    },
    "writer_identity": {
      "minLength": 1,
      "title": "Writer Identity",
      "type": "string"
    },
    "writer_installation_id": {
      "title": "Writer Installation Id",
      "type": "integer"
    }
  },
  "required": [
    "operation_id",
    "activation_digest",
    "repository_digest",
    "hosted_identity_root_artifact",
    "hosted_identity_bundle_digest",
    "activation_artifact",
    "source_operation_id",
    "source_plan_digest",
    "source_plan_artifact",
    "source_package_digest",
    "source_package_artifact",
    "source_composition_digest",
    "source_composition_artifact",
    "source_composition_proof_artifact",
    "base_commit",
    "base_tree",
    "candidate_commit",
    "candidate_tree",
    "candidate_ref",
    "candidate_parents",
    "writer_app_id",
    "writer_installation_id",
    "writer_identity",
    "observer_configuration_digest",
    "protection_ruleset_digest",
    "lease_identity",
    "lease_digest",
    "lease_artifact",
    "lease_expires_at",
    "claim_nonce",
    "claim_digest",
    "policy_digest",
    "protocol_digest",
    "root_digest"
  ],
  "title": "MainPersonalExactCasControllerComposition",
  "type": "object"
}
