{
  "additionalProperties": false,
  "properties": {
    "authorization_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Digest",
      "type": "string"
    },
    "authorized": {
      "const": true,
      "default": true,
      "title": "Authorized",
      "type": "boolean"
    },
    "authorized_at": {
      "format": "date-time",
      "title": "Authorized At",
      "type": "string"
    },
    "completion_package_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Completion Package Digest",
      "type": "string"
    },
    "composition_artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Composition Artifact Digest",
      "type": "string"
    },
    "composition_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Composition Id",
      "type": "string"
    },
    "controller_config_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Controller Config Digest",
      "type": "string"
    },
    "current_main_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Current Main Commit",
      "type": "string"
    },
    "current_main_parent_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Current Main Parent Commit",
      "type": "string"
    },
    "current_main_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Current Main Tree",
      "type": "string"
    },
    "deploy_performed": {
      "const": false,
      "default": false,
      "title": "Deploy Performed",
      "type": "boolean"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "inverse_delta_artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Inverse Delta Artifact Digest",
      "type": "string"
    },
    "inverse_delta_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Inverse Delta Digest",
      "type": "string"
    },
    "inverse_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Inverse Tree",
      "type": "string"
    },
    "issuer_isolation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Issuer Isolation Digest",
      "type": "string"
    },
    "lease_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Lease Digest",
      "type": "string"
    },
    "lease_epoch_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Lease Epoch Digest",
      "type": "string"
    },
    "lease_identity": {
      "minLength": 1,
      "title": "Lease Identity",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "original_delta_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Original Delta Digest",
      "type": "string"
    },
    "policy_epoch": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Epoch",
      "type": "string"
    },
    "release_issuer_app_id": {
      "exclusiveMinimum": 0,
      "title": "Release Issuer App Id",
      "type": "integer"
    },
    "release_issuer_identity": {
      "minLength": 1,
      "title": "Release Issuer Identity",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 3,
      "default": 3,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Operation Id",
      "type": "string"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    }
  },
  "required": [
    "repository_digest",
    "operation_id",
    "source_operation_id",
    "composition_id",
    "composition_artifact_digest",
    "completion_package_digest",
    "original_delta_digest",
    "current_main_commit",
    "current_main_tree",
    "current_main_parent_commit",
    "inverse_delta_digest",
    "inverse_delta_artifact_digest",
    "inverse_tree",
    "lease_identity",
    "lease_digest",
    "lease_epoch_digest",
    "policy_epoch",
    "controller_config_digest",
    "release_issuer_identity",
    "release_issuer_app_id",
    "issuer_isolation_digest",
    "authorization_digest",
    "expires_at",
    "authorized_at"
  ],
  "title": "MainRollbackAuthorization",
  "type": "object"
}
