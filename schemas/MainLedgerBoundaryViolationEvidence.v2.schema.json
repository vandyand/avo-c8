{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "role",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "MainLedgerControllerAuthority": {
      "additionalProperties": false,
      "description": "Self-contained controller root, not an authentication primitive.\n\nPersistence and service callers must supply an injected verifier that\nauthenticates this authority and its issuer before using this DTO.",
      "properties": {
        "authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Authority Digest",
          "type": "string"
        },
        "authorized_at": {
          "format": "date-time",
          "title": "Authorized At",
          "type": "string"
        },
        "controller_config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Controller Config Digest",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "issuer_authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Issuer Authority Digest",
          "type": "string"
        },
        "issuer_identity": {
          "minLength": 1,
          "title": "Issuer Identity",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "policy_epoch": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Epoch",
          "type": "string"
        },
        "protocol_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Protocol Digest",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_ref": {
          "const": "refs/heads/main",
          "default": "refs/heads/main",
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "repository_digest",
        "protocol_digest",
        "controller_config_digest",
        "policy_digest",
        "policy_epoch",
        "issuer_identity",
        "issuer_authority_digest",
        "authorized_at",
        "expires_at",
        "authority_digest"
      ],
      "title": "MainLedgerControllerAuthority",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Controller-owned, out-of-band proof that an activation must terminate.",
  "properties": {
    "activation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Activation Digest",
      "type": "string"
    },
    "controller_authority": {
      "$ref": "#/$defs/MainLedgerControllerAuthority"
    },
    "current_state_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Current State Digest",
      "type": "string"
    },
    "detected_at": {
      "format": "date-time",
      "title": "Detected At",
      "type": "string"
    },
    "evidence_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "expected_scheduler_sequence": {
      "exclusiveMinimum": 0,
      "title": "Expected Scheduler Sequence",
      "type": "integer"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "violation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Violation Digest",
      "type": "string"
    },
    "violation_kind": {
      "enum": [
        "starvation",
        "withholding",
        "silent_exclusion",
        "scheduler_gap",
        "operator_intervention"
      ],
      "title": "Violation Kind",
      "type": "string"
    }
  },
  "required": [
    "activation_digest",
    "controller_authority",
    "expected_scheduler_sequence",
    "current_state_digest",
    "violation_kind",
    "evidence_artifact",
    "detected_at",
    "violation_digest"
  ],
  "title": "MainLedgerBoundaryViolationEvidence",
  "type": "object"
}
