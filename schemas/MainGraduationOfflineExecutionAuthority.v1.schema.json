{
  "$defs": {
    "MainGraduationOfflineExecutionNodeSpec": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "expected_outcome": {
          "enum": [
            "passed",
            "pass",
            "success",
            "rejected",
            "safe_rejection",
            "reconciliation_required",
            "reconcile",
            "failed",
            "replayed"
          ],
          "title": "Expected Outcome",
          "type": "string"
        },
        "expected_state": {
          "enum": [
            "unchanged",
            "failed_closed",
            "reconciled",
            "completed",
            "replayed_read_only",
            "rejected",
            "reconciliation_required",
            "read_only"
          ],
          "title": "Expected State",
          "type": "string"
        },
        "node_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "parameter_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Parameter Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "vector_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,95}$",
          "title": "Vector Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "parameter_id",
        "case_id",
        "vector_id",
        "expected_outcome",
        "expected_state"
      ],
      "title": "MainGraduationOfflineExecutionNodeSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Controller-owned authority manifest for one exact offline pytest run.",
  "properties": {
    "activation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Activation Digest",
      "type": "string"
    },
    "argv": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Argv",
      "type": "array"
    },
    "authority_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authority Digest",
      "type": "string"
    },
    "authorized_at": {
      "format": "date-time",
      "title": "Authorized At",
      "type": "string"
    },
    "configuration_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Configuration Digest",
      "type": "string"
    },
    "controller_authority_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Controller Authority Digest",
      "type": "string"
    },
    "controller_authority_ref": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Controller Authority Ref",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "interpreter_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Interpreter Digest",
      "type": "string"
    },
    "issuer_identity": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Issuer Identity",
      "type": "string"
    },
    "lockfile_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Lockfile Digest",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/MainGraduationOfflineExecutionNodeSpec"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "normalized_report_media_type": {
      "const": "application/vnd.avo.c7.execution-report+json",
      "default": "application/vnd.avo.c7.execution-report+json",
      "title": "Normalized Report Media Type",
      "type": "string"
    },
    "normalized_report_schema_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Normalized Report Schema Digest",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "plugin_set_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plugin Set Digest",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "protocol_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protocol Digest",
      "type": "string"
    },
    "pytest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Pytest Digest",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Source Commit",
      "type": "string"
    },
    "source_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Source Tree",
      "type": "string"
    },
    "source_tree_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Tree Digest",
      "type": "string"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    },
    "toolchain_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Toolchain Digest",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "authority_digest",
    "controller_authority_digest",
    "controller_authority_ref",
    "issuer_identity",
    "repository_digest",
    "source_commit",
    "source_tree",
    "source_tree_digest",
    "protocol_digest",
    "configuration_digest",
    "policy_digest",
    "activation_digest",
    "lockfile_digest",
    "interpreter_digest",
    "pytest_digest",
    "plugin_set_digest",
    "toolchain_digest",
    "argv",
    "normalized_report_schema_digest",
    "authorized_at",
    "expires_at",
    "nodes"
  ],
  "title": "MainGraduationOfflineExecutionAuthority",
  "type": "object"
}
