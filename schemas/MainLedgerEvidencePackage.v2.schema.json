    "MainLedgerSubmissionEnvelope": {
      "additionalProperties": false,
      "description": "Immutable scheduler receipt written before candidate content inspection.",
      "properties": {
        "activation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Activation Digest",
          "type": "string"
        },
        "content_inspected": {
          "const": false,
          "default": false,
          "title": "Content Inspected",
          "type": "boolean"
        },
        "deploy_performed": {
          "const": false,
          "default": false,
          "title": "Deploy Performed",
