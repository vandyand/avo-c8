{
  "$defs": {
    "MainLedgerAccumulatorState": {
      "additionalProperties": false,
      "description": "Content-addressed state used as the CAS predecessor of a transition.",
      "properties": {
        "activation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Activation Digest",
          "type": "string"
        },
        "boundary_violations": {
          "minimum": 0,
          "title": "Boundary Violations",
          "type": "integer"
        },
        "failures": {
          "minimum": 0,
          "title": "Failures",
          "type": "integer"
        },
        "last_scheduler_sequence": {
          "minimum": 0,
          "title": "Last Scheduler Sequence",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "state_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "State Digest",
          "type": "string"
        },
        "streak": {
          "maximum": 12,
          "minimum": 0,
          "title": "Streak",
          "type": "integer"
        },
        "successes": {
          "minimum": 0,
          "title": "Successes",
          "type": "integer"
        },
        "threshold_complete": {
          "title": "Threshold Complete",
          "type": "boolean"
        }
      },
      "required": [
        "activation_digest",
        "last_scheduler_sequence",
        "streak",
        "successes",
        "failures",
        "boundary_violations",
        "threshold_complete",
        "state_digest"
      ],
      "title": "MainLedgerAccumulatorState",
      "type": "object"
    },
    "MainLedgerAccumulatorTransition": {
      "additionalProperties": false,
      "description": "CAS transition for every submission, including an exclusion.",
      "properties": {
        "activation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Activation Digest",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/MainLedgerClassificationEvidence"
        },
        "deploy_performed": {
          "const": false,
          "default": false,
          "title": "Deploy Performed",
          "type": "boolean"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/MainLedgerTerminalOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Digest"
        },
        "prior_state": {
          "$ref": "#/$defs/MainLedgerAccumulatorState"
        },
        "prior_state_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Prior State Digest",
          "type": "string"
        },
        "reset_applied": {
          "title": "Reset Applied",
          "type": "boolean"
        },
        "resulting_state": {
          "$ref": "#/$defs/MainLedgerAccumulatorState"
        },
        "resulting_state_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Resulting State Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "transition_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Transition Digest",
          "type": "string"
        }
      },
      "required": [
        "activation_digest",
        "classification",
        "prior_state",
        "prior_state_digest",
        "reset_applied",
        "resulting_state",
        "resulting_state_digest",
        "transition_digest"
      ],
      "title": "MainLedgerAccumulatorTransition",
      "type": "object"
    },
    "MainLedgerActivation": {
      "additionalProperties": false,
      "description": "Frozen controller root for one 12-success campaign.",
      "properties": {
        "activated_at": {
          "format": "date-time",
          "title": "Activated At",
          "type": "string"
        },
        "activation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Activation Digest",
          "type": "string"
        },
        "c8_capability_evidence": {
          "$ref": "#/$defs/MainLedgerC8CapabilityEvidence"
        },
        "c8_capability_evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "C8 Capability Evidence Digest",
          "type": "string"
        },
        "controller_authority": {
          "$ref": "#/$defs/MainLedgerControllerAuthority"
        },
        "controller_config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Controller Config Digest",
          "type": "string"
        },
        "controller_issuer_authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Controller Issuer Authority Digest",
          "type": "string"
        },
        "controller_issuer_identity": {
          "minLength": 1,
          "title": "Controller Issuer Identity",
          "type": "string"
        },
        "deploy_performed": {
          "const": false,
          "default": false,
          "title": "Deploy Performed",
          "type": "boolean"
        },
        "freshness_cutoff": {
          "format": "date-time",
          "title": "Freshness Cutoff",
          "type": "string"
        },
        "hosted_rollback_artifact_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Hosted Rollback Artifact Digest",
          "type": "string"
        },
        "hosted_rollback_proof": {
          "$ref": "#/$defs/MainLedgerHostedRollbackProof"
        },
        "hosted_rollback_proof_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Hosted Rollback Proof Digest",
          "type": "string"
        },
        "initial_streak": {
          "const": 0,
          "default": 0,
          "title": "Initial Streak",
          "type": "integer"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "policy_epoch": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Epoch",
          "type": "string"
        },
        "protocol_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Protocol Digest",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "rollback_authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rollback Authority Digest",
          "type": "string"
        },
        "rollback_authority_identity": {
          "minLength": 1,
          "title": "Rollback Authority Identity",
          "type": "string"
        },
        "scheduler_sequence_watermark": {
          "minimum": 0,
          "title": "Scheduler Sequence Watermark",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_ref": {
          "const": "refs/heads/main",
          "default": "refs/heads/main",
          "title": "Target Ref",
          "type": "string"
        },
        "threshold": {
          "const": 12,
          "default": 12,
          "title": "Threshold",
          "type": "integer"
        }
      },
      "required": [
        "repository_digest",
        "protocol_digest",
        "controller_config_digest",
        "policy_digest",
        "policy_epoch",
        "controller_issuer_identity",
        "controller_issuer_authority_digest",
        "scheduler_sequence_watermark",
        "freshness_cutoff",
        "controller_authority",
        "hosted_rollback_proof",
        "c8_capability_evidence",
        "hosted_rollback_proof_digest",
        "hosted_rollback_artifact_digest",
        "rollback_authority_identity",
        "rollback_authority_digest",
        "c8_capability_evidence_digest",
        "activated_at",
        "activation_digest"
      ],
      "title": "MainLedgerActivation",
      "type": "object"
    },
    "MainLedgerC8CapabilityEvidence": {
      "additionalProperties": false,
      "description": "Controller-observed hosting, queue, validation, and release capability.",
      "properties": {
        "bypass_allowed": {
          "const": false,
          "default": false,
          "title": "Bypass Allowed",
          "type": "boolean"
        },
        "controller_authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Controller Authority Digest",
          "type": "string"
        },
        "direct_merge_allowed": {
          "const": false,
          "default": false,
          "title": "Direct Merge Allowed",
          "type": "boolean"
        },
        "evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "hosting_authority_identity": {
          "minLength": 1,
          "title": "Hosting Authority Identity",
          "type": "string"
        },
        "max_entries_per_group": {
          "const": 1,
          "default": 1,
          "title": "Max Entries Per Group",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "queue_configuration_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Queue Configuration Digest",
          "type": "string"
        },
        "queue_generation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Queue Generation Digest",
          "type": "string"
        },
        "queue_required": {
          "const": true,
          "default": true,
          "title": "Queue Required",
          "type": "boolean"
        },
        "release_issuer_app_id": {
          "exclusiveMinimum": 0,
          "title": "Release Issuer App Id",
          "type": "integer"
        },
        "release_issuer_authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Release Issuer Authority Digest",
          "type": "string"
        },
        "release_issuer_identity": {
          "minLength": 1,
          "title": "Release Issuer Identity",
          "type": "string"
        },
        "release_issuer_isolated": {
          "const": true,
          "default": true,
          "title": "Release Issuer Isolated",
          "type": "boolean"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_ref": {
          "const": "refs/heads/main",
          "default": "refs/heads/main",
          "title": "Target Ref",
          "type": "string"
        },
        "validation_app_id": {
          "const": 15368,
          "default": 15368,
          "title": "Validation App Id",
          "type": "integer"
        }
      },
      "required": [
        "repository_digest",
        "controller_authority_digest",
        "hosting_authority_identity",
        "queue_configuration_digest",
        "queue_generation_digest",
        "release_issuer_identity",
        "release_issuer_app_id",
        "release_issuer_authority_digest",
        "observed_at",
        "evidence_digest"
      ],
      "title": "MainLedgerC8CapabilityEvidence",
      "type": "object"
    },
    "MainLedgerClassificationEvidence": {
      "additionalProperties": false,
      "description": "Controller-owned classification; exclusions require independent proof.",
      "properties": {
        "activation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Activation Digest",
          "type": "string"
        },
        "classification": {
          "enum": [
            "eligible",
            "excluded"
          ],
          "title": "Classification",
          "type": "string"
        },
        "classification_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Classification Digest",
          "type": "string"
        },
        "controller_authority": {
          "$ref": "#/$defs/MainLedgerControllerAuthority"
        },
        "deploy_performed": {
          "const": false,
          "default": false,
          "title": "Deploy Performed",
          "type": "boolean"
        },
        "empty": {
          "title": "Empty",
          "type": "boolean"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "enum": [
                "empty",
                "nonordinary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Reason"
        },
        "independent_exclusion_evidence_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Independent Exclusion Evidence Digest"
        },
        "issuer_authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Issuer Authority Digest",
          "type": "string"
        },
        "issuer_domain": {
          "const": "controller-policy",
          "default": "controller-policy",
          "title": "Issuer Domain",
          "type": "string"
        },
        "issuer_identity": {
          "minLength": 1,
          "title": "Issuer Identity",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "ordinary": {
          "title": "Ordinary",
          "type": "boolean"
        },
        "path_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Path Manifest Digest",
          "type": "string"
        },
        "paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "policy_epoch": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Epoch",
          "type": "string"
        },
        "risk_class": {
          "enum": [
            "ordinary",
            "nonordinary"
          ],
          "title": "Risk Class",
          "type": "string"
        },
        "scheduler_sequence": {
          "exclusiveMinimum": 0,
          "title": "Scheduler Sequence",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "submission_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Submission Digest",
          "type": "string"
        }
      },
      "required": [
        "activation_digest",
        "submission_digest",
        "operation_id",
        "scheduler_sequence",
        "classification",
        "empty",
        "ordinary",
        "risk_class",
        "paths",
        "path_manifest_digest",
        "policy_digest",
        "policy_epoch",
        "controller_authority",
        "issuer_identity",
        "issuer_authority_digest",
        "classification_digest"
      ],
      "title": "MainLedgerClassificationEvidence",
      "type": "object"
    },
    "MainLedgerControllerAuthority": {
      "additionalProperties": false,
      "description": "Self-contained controller root, not an authentication primitive.\n\nPersistence and service callers must supply an injected verifier that\nauthenticates this authority and its issuer before using this DTO.",
      "properties": {
        "authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Authority Digest",
          "type": "string"
        },
        "authorized_at": {
          "format": "date-time",
          "title": "Authorized At",
          "type": "string"
        },
        "controller_config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Controller Config Digest",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "issuer_authority_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Issuer Authority Digest",
          "type": "string"
        },
        "issuer_identity": {
          "minLength": 1,
          "title": "Issuer Identity",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "policy_epoch": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Epoch",
          "type": "string"
        },
        "protocol_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Protocol Digest",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_ref": {
          "const": "refs/heads/main",
          "default": "refs/heads/main",
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "repository_digest",
        "protocol_digest",
        "controller_config_digest",
        "policy_digest",
        "policy_epoch",
        "issuer_identity",
        "issuer_authority_digest",
        "authorized_at",
        "expires_at",
        "authority_digest"
      ],
      "title": "MainLedgerControllerAuthority",
      "type": "object"
    },
    "MainLedgerHostedRollbackProof": {
