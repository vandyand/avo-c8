      "title": "MainLedgerSubmissionEnvelope",
      "type": "object"
    },
    "MainLedgerTerminalOutcome": {
      "additionalProperties": false,
      "description": "One append-only terminal outcome for one eligible scheduler submission.",
      "properties": {
        "activation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Activation Digest",
          "type": "string"
        },
        "attempt_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "boundary_violation": {
          "default": false,
          "title": "Boundary Violation",
          "type": "boolean"
