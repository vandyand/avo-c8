    "base_commit",
    "candidate_commit",
    "candidate_tree",
    "candidate_parents",
    "source_composition_digest",
    "verified_policy_digest",
    "configuration_digest",
    "publisher_app_id",
    "publisher_installation_id",
    "publisher_identity",
    "intent_created_at",
