      "title": "Completion Authorized",
      "type": "boolean"
    },
    "configuration_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Configuration Digest",
      "type": "string"
    },
    "deploy_performed": {
      "const": false,
      "default": false,
      "title": "Deploy Performed",
      "type": "boolean"
    },
    "intent_created_at": {
      "format": "date-time",
      "title": "Intent Created At",
      "type": "string"
    },
    "intent_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Intent Digest",
      "type": "string"
    },
    "is_authoritative": {
      "const": false,
      "default": false,
      "title": "Is Authoritative",
      "type": "boolean"
    },
    "is_terminal": {
      "const": false,
      "default": false,
      "title": "Is Terminal",
      "type": "boolean"
    },
    "mutation_performed": {
      "const": false,
      "default": false,
      "title": "Mutation Performed",
      "type": "boolean"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "publisher_app_id": {
      "exclusiveMinimum": 0,
      "title": "Publisher App Id",
      "type": "integer"
    },
    "publisher_identity": {
      "const": "avo-c8-candidate-publisher-vandyand",
      "title": "Publisher Identity",
      "type": "string"
    },
    "publisher_installation_id": {
      "exclusiveMinimum": 0,
      "title": "Publisher Installation Id",
      "type": "integer"
    },
    "readiness_authorized": {
      "const": false,
      "default": false,
      "title": "Readiness Authorized",
      "type": "boolean"
    },
    "receipt_issued": {
      "const": false,
      "default": false,
      "title": "Receipt Issued",
      "type": "boolean"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "repository_id": {
      "exclusiveMinimum": 0,
      "title": "Repository Id",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_composition_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Composition Digest",
      "type": "string"
    },
    "verified_policy_digest": {
