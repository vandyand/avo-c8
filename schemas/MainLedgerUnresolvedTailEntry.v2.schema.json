{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "role",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "MainLedgerSubmissionEnvelope": {
      "additionalProperties": false,
      "description": "Immutable scheduler receipt written before candidate content inspection.",
      "properties": {
        "activation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Activation Digest",
          "type": "string"
        },
        "content_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "content_inspected": {
          "const": false,
          "default": false,
          "title": "Content Inspected",
          "type": "boolean"
        },
        "deploy_performed": {
          "const": false,
          "default": false,
          "title": "Deploy Performed",
          "type": "boolean"
        },
        "envelope_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Envelope Digest",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "scheduler_sequence": {
          "exclusiveMinimum": 0,
          "title": "Scheduler Sequence",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_identity": {
          "minLength": 1,
          "title": "Source Identity",
          "type": "string"
        },
        "submission_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Submission Digest",
          "type": "string"
        },
        "submission_identity": {
          "minLength": 1,
          "title": "Submission Identity",
          "type": "string"
        },
        "target_ref": {
          "const": "refs/heads/main",
          "default": "refs/heads/main",
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "activation_digest",
        "repository_digest",
        "scheduler_sequence",
        "source_identity",
        "submission_identity",
        "submission_digest",
        "content_artifact",
        "operation_id",
        "recorded_at",
        "envelope_digest"
      ],
      "title": "MainLedgerSubmissionEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One scheduler sequence which is intentionally left unresolved.\n\nAn entry can carry the envelope itself (the compact prefix/tail form), or\nbind an envelope which is present in ``EvidencePackage.submissions`` by\nits immutable identities.  The latter form keeps each durable envelope in\nthe package exactly once while still making the unresolved tail explicit.\nAn entry with no envelope or identities is the missing-envelope\n(starvation) form.",
  "properties": {
    "content_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entry_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Entry Digest",
      "type": "string"
    },
    "envelope": {
      "anyOf": [
        {
          "$ref": "#/$defs/MainLedgerSubmissionEnvelope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "envelope_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Envelope Digest"
    },
    "operation_id": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "scheduler_sequence": {
      "exclusiveMinimum": 0,
      "title": "Scheduler Sequence",
      "type": "integer"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "submission_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Digest"
    }
  },
  "required": [
    "scheduler_sequence",
    "entry_digest"
  ],
  "title": "MainLedgerUnresolvedTailEntry",
  "type": "object"
}
