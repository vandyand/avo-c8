{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "role",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Restart-safe sanitized evidence; never terminal or authoritative.",
  "properties": {
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "dispatch_marker_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Dispatch Marker Digest",
      "type": "string"
    },
    "evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Digest",
      "type": "string"
    },
    "intent_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Intent Digest",
      "type": "string"
    },
    "is_authoritative": {
      "const": false,
      "default": false,
      "title": "Is Authoritative",
      "type": "boolean"
    },
    "is_terminal": {
      "const": false,
      "default": false,
      "title": "Is Terminal",
      "type": "boolean"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "response_classification": {
      "enum": [
        "candidate_response",
        "conflict_or_rejected",
        "configuration_or_validation_rejected",
        "authentication_or_authorization_rejected",
        "rate_limited",
        "ambiguous",
        "unverifiable"
      ],
      "title": "Response Classification",
      "type": "string"
    },
    "response_metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Response Metadata",
      "type": "object"
    },
    "response_metadata_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Response Metadata Digest",
      "type": "string"
    },
    "response_payload_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "response_request_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Request Id"
    },
    "response_status": {
      "maximum": 599,
      "minimum": 100,
      "title": "Response Status",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    },
    "writer_app_id": {
      "exclusiveMinimum": 0,
      "title": "Writer App Id",
      "type": "integer"
    },
    "writer_identity": {
      "minLength": 1,
      "title": "Writer Identity",
      "type": "string"
    },
    "writer_installation_id": {
      "exclusiveMinimum": 0,
      "title": "Writer Installation Id",
      "type": "integer"
    }
  },
  "required": [
    "operation_id",
    "repository_digest",
    "writer_app_id",
    "writer_installation_id",
    "writer_identity",
    "intent_digest",
    "dispatch_marker_digest",
    "candidate_commit",
    "request_digest",
    "response_status",
    "response_classification",
    "response_metadata",
    "response_metadata_digest",
    "response_payload_artifact",
    "observed_at",
    "evidence_digest"
  ],
  "title": "MainPersonalExactCasResponseEvidence",
  "type": "object"
}
