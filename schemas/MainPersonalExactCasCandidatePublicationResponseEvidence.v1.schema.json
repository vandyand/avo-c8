          "title": "Credential Role",
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "method",
        "path",
        "credential_role"
      ],
      "title": "CandidatePublisherRequestTrace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Sanitized provider evidence; never a receipt or terminal outcome.",
  "properties": {
