      "title": "Mutation Performed",
      "type": "boolean"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "publisher_app_id": {
      "exclusiveMinimum": 0,
      "title": "Publisher App Id",
      "type": "integer"
    },
    "publisher_identity": {
      "const": "avo-c8-candidate-publisher-vandyand",
      "title": "Publisher Identity",
      "type": "string"
    },
    "publisher_installation_id": {
      "exclusiveMinimum": 0,
      "title": "Publisher Installation Id",
      "type": "integer"
    },
    "readiness_authorized": {
      "const": false,
      "default": false,
      "title": "Readiness Authorized",
