    "repository_digest",
    "repository_id",
    "candidate_ref",
    "candidate_commit",
    "intent_digest",
    "dispatch_marker_digest",
    "publisher_app_id",
    "publisher_installation_id",
    "publisher_identity",
    "configuration_digest",
    "request_digest",
    "response_status",
    "response_classification",
    "response_payload_digest",
    "requests",
    "observed_at",
