{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "role",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "MainLeaseEvidence": {
      "additionalProperties": false,
      "description": "Durable main-target lease proof; opaque lease digests are insufficient.",
      "properties": {
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "identity": {
          "minLength": 1,
          "title": "Identity",
          "type": "string"
        },
        "lease_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Lease Digest",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_ref": {
          "const": "refs/heads/main",
          "default": "refs/heads/main",
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "repository_digest",
        "operation_id",
        "identity",
        "acquired_at",
        "expires_at",
        "lease_digest"
      ],
      "title": "MainLeaseEvidence",
      "type": "object"
    },
    "MainLeaseEvidenceRecord": {
      "additionalProperties": false,
      "description": "Public durable lease record returned by the main journal API.",
      "properties": {
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "lease_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Lease Digest",
          "type": "string"
        },
        "lease_epoch_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Lease Epoch Digest",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "policy_epoch": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Epoch",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_ref": {
          "const": "refs/heads/main",
          "default": "refs/heads/main",
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "repository_digest",
        "operation_id",
        "owner",
        "policy_epoch",
        "lease_epoch_digest",
        "acquired_at",
        "expires_at",
        "lease_digest",
        "evidence_digest"
      ],
      "title": "MainLeaseEvidenceRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable C4 intent bound to the durable Phase-A lease record.\n\n``MainLeaseEvidence`` is the historical C2 lease shape.  It remains\nrepresented as an optional compatibility member so old model-constructed\nvalues can still be inspected, but a validated C4 intent must carry the\nPhase-A ``MainLeaseEvidenceRecord`` and all of its authority digests.",
  "properties": {
    "base_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Base Commit",
      "type": "string"
    },
    "base_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Base Tree",
      "type": "string"
    },
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "candidate_ref": {
      "minLength": 1,
      "title": "Candidate Ref",
      "type": "string"
    },
    "candidate_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Candidate Tree",
      "type": "string"
    },
    "composition_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Composition Digest",
      "type": "string"
    },
    "intent_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Intent Digest",
      "type": "string"
    },
    "lease_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Lease Digest",
      "type": "string"
    },
    "lease_epoch_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Lease Epoch Digest",
      "type": "string"
    },
    "lease_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/MainLeaseEvidence"
        },
        {
          "$ref": "#/$defs/MainLeaseEvidenceRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Evidence"
    },
    "lease_evidence_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "lease_evidence_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/MainLeaseEvidenceRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lease_identity": {
      "minLength": 1,
      "title": "Lease Identity",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "package_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Package Digest",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "policy_epoch": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Epoch",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "const": "intent_recorded",
      "default": "intent_recorded",
      "title": "State",
      "type": "string"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    }
  },
  "required": [
    "repository_digest",
    "operation_id",
    "plan_digest",
    "package_digest",
    "composition_digest",
    "base_commit",
    "base_tree",
    "candidate_commit",
    "candidate_tree",
    "candidate_ref",
    "lease_identity",
    "lease_digest",
    "lease_epoch_digest",
    "lease_evidence_artifact",
    "policy_epoch",
    "intent_digest",
    "recorded_at"
  ],
  "title": "MainGraduationIntent",
  "type": "object"
}
