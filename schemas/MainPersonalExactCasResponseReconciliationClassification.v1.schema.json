{
  "additionalProperties": false,
  "description": "Durable response classification; never terminal or authoritative.",
  "properties": {
    "classification": {
      "enum": [
        "candidate_observed",
        "conclusive_rejection_observed",
        "reconciliation_required"
      ],
      "title": "Classification",
      "type": "string"
    },
    "classification_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Classification Digest",
      "type": "string"
    },
    "classified_at": {
      "format": "date-time",
      "title": "Classified At",
      "type": "string"
    },
    "dispatch_marker_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Dispatch Marker Digest",
      "type": "string"
    },
    "intent_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Intent Digest",
      "type": "string"
    },
    "is_authoritative": {
      "const": false,
      "default": false,
      "title": "Is Authoritative",
      "type": "boolean"
    },
    "is_terminal": {
      "const": false,
      "default": false,
      "title": "Is Terminal",
      "type": "boolean"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "response_classification": {
      "title": "Response Classification",
      "type": "string"
    },
    "response_evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Response Evidence Digest",
      "type": "string"
    },
    "response_status": {
      "maximum": 599,
      "minimum": 100,
      "title": "Response Status",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    },
    "writer_app_id": {
      "exclusiveMinimum": 0,
      "title": "Writer App Id",
      "type": "integer"
    },
    "writer_identity": {
      "minLength": 1,
      "title": "Writer Identity",
      "type": "string"
    },
    "writer_installation_id": {
      "exclusiveMinimum": 0,
      "title": "Writer Installation Id",
      "type": "integer"
    }
  },
  "required": [
    "operation_id",
    "repository_digest",
    "writer_app_id",
    "writer_installation_id",
    "writer_identity",
    "intent_digest",
    "dispatch_marker_digest",
    "response_evidence_digest",
    "response_status",
    "response_classification",
    "classification",
    "classified_at",
    "classification_digest"
  ],
  "title": "MainPersonalExactCasResponseReconciliationClassification",
  "type": "object"
}
